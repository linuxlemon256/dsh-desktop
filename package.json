{
  "name": "dsh-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "A lightweight Electron desktop client for DeepSeek Harness (dsh): boots the `dsh web` server and opens its UI in a native window.",
  "main": "src/main.js",
  "license": "MIT",
  "author": {
    "name": "linuxlemon256",
    "email": "297761464@qq.com"
  },
  "homepage": "https://github.com/linuxlemon256/dsh-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linuxlemon256/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/linuxlemon256/dsh-desktop/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "electron",
    "desktop",
    "harness",
    "ai"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "pack": "electron-builder --dir --publish never",
    "build": "electron-builder --win --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.linuxlemon256.dsh-desktop",
    "productName": "DeepSeek Harness Desktop",
    "files": [
      "src/main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": ["node/**/*", "dsh/**/*", "pnpm/**/*", "bin/**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12"
  }
}
